6000.0 1600.0 0.0 1.8 0.1 / ! BOTTOM properties
1                           ! Nsx
0.0 /                       ! source x (km)
1                           ! Nsy
0.0 /                       ! source y (km)
1                           ! NSD
1440 /                      ! source depth (m)
1                           ! NRD - one receiver depth for horizontal slice
1440 /                      ! RD -  (m)
501                         ! NR
0.0  200.0 /                ! receiver ranges (km)
721                         ! Ntheta - dense bearing coverage
-180 180 /                    ! full 180° fan toward seamounts
'CB   3'                    ! Gaussian beam, coherent TL, 3D
800                         ! Nalpha
-30 30 /                    ! elevation angles
900                         ! Nbeta
-90 90 /                    ! bearing angles
0.0  200.0  90.0  6500.0    ! STEP, Box%x (km), Box%y (km), Box%z (m)